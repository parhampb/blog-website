# Copy to .env for local builds. In production, set these as build variables
# in Cloudflare (Workers & Pages > your Worker > Settings > Build > Variables).
# All are optional: leave them empty and the feature stays off.

# Cloudflare Web Analytics site token (only used by `pnpm build`, never in dev).
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# giscus comments: values from https://giscus.app (all four, or comments stay off).
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
